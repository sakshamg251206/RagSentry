# ---------------------------------------------------------------------------
# RagSentry configuration. Copy to `.env` and fill in the required values.
# ---------------------------------------------------------------------------

# Required. Free key from https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional overrides (defaults shown) -----------------------------------

# LLM used by the auditor agents (LiteLLM model id, provider prefix required).
# RAGSENTRY_AUDITOR_MODEL=groq/llama-3.3-70b-versatile

# LLM used by the vulnerable target assistant (Groq model id).
# RAGSENTRY_TARGET_MODEL=llama-3.3-70b-versatile

# Sentence-transformers model used to embed the target's documents.
# RAGSENTRY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where the target's FAISS index is stored.
# RAGSENTRY_INDEX_DIR=.data/faiss_index

# Number of documents retrieved per question.
# RAGSENTRY_RETRIEVER_K=2

# Sampling temperatures (0.0 - 2.0).
# RAGSENTRY_AUDITOR_TEMPERATURE=0.7
# RAGSENTRY_TARGET_TEMPERATURE=0.7

# Maximum tool-use iterations per auditor agent.
# RAGSENTRY_AGENT_MAX_ITERATIONS=8

# Maximum length of a prompt sent to POST /api/target/query.
# RAGSENTRY_MAX_PROMPT_CHARS=4000

# DEBUG, INFO, WARNING or ERROR.
# RAGSENTRY_LOG_LEVEL=INFO

# URL the dashboard uses to reach the API.
# RAGSENTRY_API_URL=http://127.0.0.1:8000
